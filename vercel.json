{
  "version": 2,
  "rewrites": [
    {
      "source": "/waterlevel.ino.bin",
      "destination": "/waterlevel.bin"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/server.js"
    }
  ],
  "crons": [
    {
      "path": "/api/sms/cron",
      "schedule": "*/10 * * * *"
    }
  ]
}
